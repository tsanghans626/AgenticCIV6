{
  "name": "civi6-kb-adapter",
  "version": "0.1.0",
  "description": "Civilization VI knowledge base: read-only SQLite build pipeline, decision slices (kb_*) + DeepSeek Harness plugin (query tools)",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node --import ./scripts/ts-loader.mjs src/cli.ts build",
    "rebuild": "node --import ./scripts/ts-loader.mjs src/cli.ts build --force",
    "build:bbg": "node --import ./scripts/ts-loader.mjs src/cli.ts build --source bbg",
    "build:all": "node --import ./scripts/ts-loader.mjs src/cli.ts build --source all",
    "rebuild:bbg": "node --import ./scripts/ts-loader.mjs src/cli.ts build --source bbg --force",
    "fetch:bbg": "node --import ./scripts/ts-loader.mjs src/cli.ts fetch-bbg",
    "reindex": "node --import ./scripts/ts-loader.mjs src/cli.ts reindex",
    "reindex:bbg": "node --import ./scripts/ts-loader.mjs src/cli.ts reindex --source bbg",
    "effects:build": "node --import ./scripts/ts-loader.mjs src/cli.ts effects-build",
    "effects:build:bbg": "node --import ./scripts/ts-loader.mjs src/cli.ts effects-build --source bbg",
    "kb:build": "node --import ./scripts/ts-loader.mjs src/cli.ts kb-build",
    "kb:build:bbg": "node --import ./scripts/ts-loader.mjs src/cli.ts kb-build --source bbg",
    "kb:verify": "node scripts/verify-kb.mjs",
    "verify": "node scripts/verify-sources.mjs",
    "verify:parity": "node --import ./scripts/ts-loader.mjs scripts/verify-spec-parity.mjs",
    "verify:plugin": "node scripts/verify-plugin.mjs",
    "verify:effects": "node scripts/verify-effects.mjs && npm run verify:parity && npm run verify:plugin",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fast-xml-parser": "^4.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4"
  }
}
