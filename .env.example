# --- Civ 6 数据源（只读）位置 ---
# 留空则自动探测 macOS Steam 默认安装路径。
# macOS:   CIV6_ASSETS=/path/to/Civ6.app/Contents/Assets
# Windows: CIV6_ASSETS=E:\SteamLibrary\steamapps\common\Sid Meier's Civilization VI
#          （该目录下应直接包含 Base\ 与 DLC\）

# --- 输出目录（本适配器唯一写入位置）---
# 默认 ./data，相对工作区根目录。标准规则库、BBG 库、BBG 源码缓存都写这里。
# CIV6_OUTPUT=./data

# --- 数据范围（可选游戏模式 / 场景默认排除，避免污染标准规则数据）---
# CIV6_INCLUDE_MODES=1         # 纳入僵尸/秘密结社/垄断等游戏模式数据
# CIV6_INCLUDE_SCENARIOS=1     # 纳入剧本/场景数据（可能覆盖核心实体，慎用）

# --- 语言（逗号分隔）---
# CIV6_LANGS=en_US,zh_Hans_CN

# --- BBG 数据源 ---
# 默认使用官方 GitHub 固定 tag 7.5.1，并由 npm run fetch:bbg 缓存到 data/bbg-src/<ref>。
# CIV6_BBG_REF=7.5.1
# 或者直接指向已安装/已解压的 BBG Mod 目录（需包含 BetterBalancedGame.modinfo）：
# CIV6_BBG_DIR=E:\path\to\BetterBalancedGame
# 构建 BBG 库（复制标准库 + 执行 BBG SQL/文本 + 效果卡）：
#   npm run fetch:bbg
#   npm run build:bbg

# --- 插件运行时（DSH 侧）---
# 通常写在 dsh-plugin/cordis.patch.yml 的 config.layersDir / config.defaultLayer；
# 数值层由 layersDir 下的 *.sqlite 自动发现（读各库 _meta.ruleset），不枚举类型。
# 每次调用 civi6_instance / civi6_eval / civi6_pace 用 layer 选择数据库；
# civi6_pace_eval 从 handle 继承层。相对路径以插件目录为基准。
# 这里的环境变量仅用于临时覆盖。
# CIVI6_LAYERS_DIR=../data
# CIVI6_DATA_SOURCE 已废弃（映射为 defaultLayer）
# CIVI6_DB_PATH / CIVI6_BBG_DB_PATH 仍供构建/验证脚本使用，不再作为插件层配置
