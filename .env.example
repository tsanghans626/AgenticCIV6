# --- Civ 6 数据源（只读）位置 ---
# 留空则自动探测 macOS Steam 默认安装路径。
# CIV6_ASSETS=/path/to/Civ6.app/Contents/Assets

# --- 输出目录（本适配器唯一写入位置）---
# 默认 ./data，相对工作区根目录。
# CIV6_OUTPUT=./data

# --- 向量/RAG 嵌入（可选）---
# 不设置时，/api/search 走 BM25 词法检索（离线、零依赖）。
# 设置后，构建时对实体文档生成 OpenAI 嵌入，检索自动升级为混合（BM25 + 向量）。
# OPENAI_API_KEY=sk-...
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- REST API ---
# PORT=8787
# HOST=127.0.0.1

# --- 数据范围（可选游戏模式 / 场景默认排除，避免污染标准规则数据）---
# CIV6_INCLUDE_MODES=1         # 纳入僵尸/秘密结社/垄断等游戏模式数据
# CIV6_INCLUDE_SCENARIOS=1     # 纳入剧本/场景数据（可能覆盖核心实体，慎用）

# --- 语言（逗号分隔）---
# CIV6_LANGS=en_US,zh_Hans_CN
